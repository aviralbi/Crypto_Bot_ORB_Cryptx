# ─────────────────────────────────────────────────────────────────────────────
# BTC ORB Bot — Environment Variables Template
# Copy this file to ".env" and fill in YOUR values.
# NEVER share your .env file or commit it to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── CryptX Exchange API ──────────────────────────────────────────────────────
# Get these from CryptX dashboard → API Keys section
CRYPTX_API_KEY=YOUR_CRYPTX_API_KEY_HERE
CRYPTX_API_SECRET=YOUR_CRYPTX_API_SECRET_HERE

# ── Google Gemini AI (free at aistudio.google.com) ──────────────────────────
# 1. Go to https://aistudio.google.com
# 2. Click "Get API Key" → Create API Key
# 3. Paste it below
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Telegram Alerts (optional) ───────────────────────────────────────────────
# Only needed if telegram_enabled = True in config.py
# 1. Message @BotFather on Telegram → /newbot → get your token
# 2. Message @userinfobot to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
